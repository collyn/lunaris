[Desktop Entry]
Type=Application
Name=Lunaris Client
Comment=The stream window of the computers of a Lunaris server
Exec=lunaris-client %u
Icon=lunaris-client
Terminal=false
Categories=Network;RemoteAccess;
MimeType=x-scheme-handler/lunaris;
# Opened by lunaris:// links of the server's web page only: not in menus.
NoDisplay=true
