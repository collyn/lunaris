post_install() {
  modprobe uinput 2>/dev/null || true
  udevadm control --reload-rules 2>/dev/null || true
  udevadm trigger --subsystem-match=misc --sysname-match=uinput 2>/dev/null || true
  echo "Remote keyboard/mouse use /dev/uinput (udev rule installed)."
  # Unattended screen capture on Wayland (no portal prompt).
  systemctl daemon-reload 2>/dev/null || true
  systemctl enable --now lunaris-capture.service 2>/dev/null || true
  echo "Join a Lunaris server: lunaris-agent --enroll --server URL (as the desktop user),"
  echo "or on a headless machine: sudo lunaris-agent --system --enroll --server URL."
}
post_upgrade() {
  modprobe uinput 2>/dev/null || true
  udevadm control --reload-rules 2>/dev/null || true
  udevadm trigger --subsystem-match=misc --sysname-match=uinput 2>/dev/null || true
  systemctl daemon-reload 2>/dev/null || true
  # Runs while enabled, also when something stopped it.
  if systemctl -q is-enabled lunaris-capture.service 2>/dev/null; then
    systemctl restart lunaris-capture.service 2>/dev/null || true
  fi
  systemctl try-restart lunaris-agent-system.service 2>/dev/null || true
}
pre_remove() {
  systemctl disable --now lunaris-capture.service lunaris-agent-system.service 2>/dev/null || true
}
