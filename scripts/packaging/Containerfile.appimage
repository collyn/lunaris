# Build environment for the portable Lunaris agent AppImage.
#
# Ubuntu 22.04 base → the AppImage needs glibc >= 2.35 (Ubuntu 22.04+, Debian 12+,
# Fedora 36+, Arch, openSUSE Tumbleweed, Mint 21+ ...).
#
# Lunaris is GPL-3.0-or-later; everything bundled is compatible, nothing "nonfree":
#   Qt 6.8 LTS (LGPLv3, dynamically linked)   FFmpeg 8.1 (GPL build, static)
#   x264 (GPLv2+)   SVT-AV1 (BSD-3-Clause-Clear + AOM royalty-free patents)
#   libva (MIT)   oneVPL dispatcher (MIT)   nv-codec-headers (MIT)
FROM docker.io/library/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN for i in 1 2 3 4 5; do apt-get -o Acquire::Retries=5 update && break; echo "apt update failed, retrying"; sleep 30; done \
    && apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        build-essential clang libclang-dev cmake meson ninja-build nasm pkg-config \
        curl ca-certificates git file patchelf xz-utils python3-pip \
        libdrm-dev libx11-dev libx11-xcb-dev libxcb1-dev libxcb-dri3-dev libxext-dev \
        libxfixes-dev libxtst-dev libxrandr-dev libxdamage-dev libwayland-dev \
        libegl-dev libgl-dev libgbm-dev \
        libpipewire-0.3-dev libspa-0.2-dev libasound2-dev libopus-dev libssl-dev \
        libudev-dev libdbus-1-dev \
        libfontconfig1 libfreetype6 libxkbcommon0 libxkbcommon-x11-0 libxcb-cursor0 \
        libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 libxcb-render-util0 \
        libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 libglib2.0-0 libgl1 libegl1 \
        xvfb xauth libgl1-mesa-dri \
    && rm -rf /var/lib/apt/lists/*

ARG PREFIX=/opt/deps
ENV PKG_CONFIG_PATH=${PREFIX}/lib/pkgconfig:${PREFIX}/lib/x86_64-linux-gnu/pkgconfig \
    LD_LIBRARY_PATH=${PREFIX}/lib:${PREFIX}/lib/x86_64-linux-gnu
WORKDIR /build

# libva — newer than the distro copy so it can load every distro's (newer) drivers.
ARG LIBVA_VERSION=2.22.0
RUN git clone --depth 1 -b ${LIBVA_VERSION} https://github.com/intel/libva.git \
    && cd libva && meson setup build --prefix=${PREFIX} --libdir=lib -Dwith_x11=yes -Dwith_wayland=yes \
       -Dwith_glx=no -Ddriverdir=/usr/lib/x86_64-linux-gnu/dri:/usr/lib64/dri:/usr/lib/dri \
    && ninja -C build install && install -Dm644 COPYING ${PREFIX}/share/licenses/libva/COPYING && cd .. && rm -rf libva

# FFmpeg 8.1: the same trimmed, *static* build the distro packages use
# (build-ffmpeg-static.sh: VAAPI/NVENC/QSV encoders, x264, SVT-AV1, h264/hevc/av1
# decoders incl. dav1d, swscale). Static means it is folded into the agent and
# client binaries and no libav*.so is bundled. libva/libdrm stay dynamic.
# Also leaves the licence texts in ${PREFIX}/share/licenses.
COPY build-ffmpeg-static.sh /tmp/build-ffmpeg-static.sh
RUN bash /tmp/build-ffmpeg-static.sh ${PREFIX} && rm /tmp/build-ffmpeg-static.sh

# Qt 6.8 LTS from the official LGPL binaries.
ARG QT_VERSION=6.8.3
RUN pip3 install --no-cache-dir aqtinstall \
    && aqt install-qt linux desktop ${QT_VERSION} linux_gcc_64 -m qtmultimedia qtshadertools -O /opt/Qt \
    && rm -rf /opt/Qt/${QT_VERSION}/gcc_64/doc /opt/Qt/${QT_VERSION}/gcc_64/examples
ENV QTDIR=/opt/Qt/${QT_VERSION}/gcc_64
ENV QMAKE=${QTDIR}/bin/qmake PATH=${QTDIR}/bin:$PATH \
    LD_LIBRARY_PATH=${QTDIR}/lib:${PREFIX}/lib:${PREFIX}/lib/x86_64-linux-gnu

# linuxdeploy + Qt plugin (run extracted: no FUSE inside containers).
RUN cd /opt && for t in linuxdeploy-x86_64 linuxdeploy-plugin-qt-x86_64; do \
        repo=$( [ "$t" = linuxdeploy-x86_64 ] && echo linuxdeploy || echo linuxdeploy-plugin-qt ); \
        curl -fsSLo $t.AppImage https://github.com/linuxdeploy/$repo/releases/download/continuous/$t.AppImage \
        && chmod +x $t.AppImage && ./$t.AppImage --appimage-extract >/dev/null \
        && mv squashfs-root $t && rm $t.AppImage && chmod -R a+rX /opt/$t \
        && printf '#!/bin/sh\nexec /opt/%s/AppRun "$@"\n' $t > /usr/local/bin/$t \
        && chmod +x /usr/local/bin/$t; \
    done

# PipeWire 1.0 headers + libpipewire to compile against: the pipewire/libspa
# crates need newer SPA headers than Ubuntu 22.04's 0.3.48. Build-time only —
# the AppImage excludes libpipewire and uses the host's at runtime.
ARG PIPEWIRE_VERSION=1.0.7
RUN for i in 1 2 3 4 5; do apt-get -o Acquire::Retries=5 update \
        && apt-get -o Acquire::Retries=5 install -y --no-install-recommends libglib2.0-dev && break; \
        echo "apt failed, retrying"; sleep 30; done \
    && rm -rf /var/lib/apt/lists/* \
    && git clone --depth 1 -b ${PIPEWIRE_VERSION} https://gitlab.freedesktop.org/pipewire/pipewire.git \
    && meson setup pipewire/build pipewire --prefix=${PREFIX} --libdir=lib -Dauto_features=disabled \
       -Dsession-managers=[] -Dexamples=disabled -Dtests=disabled -Dman=disabled -Ddocs=disabled \
    && ninja -C pipewire/build install && rm -rf pipewire

# Qt Multimedia (QVideoSink in the client) links libpulse; linuxdeploy can only bundle
# it when it is installed here.
RUN apt-get update && apt-get -o Acquire::Retries=5 install -y --no-install-recommends libpulse0 \
    && rm -rf /var/lib/apt/lists/*

# Slim ICU data. Qt Core links ICU 73 (there is no ICU-free build of the official
# binaries) and its libicudata.so.73 is 30 MB, nearly all of it locale, currency,
# time-zone-name and transliteration data Lunaris never looks at. Build the same
# ICU release (73.2) from source with icu-data-filter.json and keep only the data
# library; make-appimage.sh swaps it in for the bundled one. Only the data differs:
# libicuuc / libicui18n stay Qt's own. See the filter file for what is kept.
ARG ICU_VERSION=73.2
ARG ICU_TAG=release-73-2
ARG ICU_FILE=73_2
COPY icu-data-filter.json /tmp/icu-data-filter.json
RUN set -e; v=${ICU_VERSION}; u=${ICU_FILE}; cd /tmp \
    && for f in icu4c-$u-src.tgz icu4c-$u-data.zip; do \
        for i in 1 2 3 4 5; do curl -fsSLO https://github.com/unicode-org/icu/releases/download/${ICU_TAG}/$f && break; sleep 10; done; done \
    && echo "818a80712ed3caacd9b652305e01afc7fa167e6f2e94996da44b90c2ab604ce1  icu4c-73_2-src.tgz" | sha256sum -c - \
    && echo "ca1ee076163b438461e484421a7679fc33a64cd0a54f9d4b401893fa1eb42701  icu4c-73_2-data.zip" | sha256sum -c - \
    && apt-get update && apt-get install -y --no-install-recommends unzip python3-jsonschema \
    && tar xzf icu4c-$u-src.tgz && unzip -qo icu4c-$u-data.zip -d icu/source \
    && rm icu/source/data/in/icudt*l.dat \
    && cd icu/source && ICU_DATA_FILTER_FILE=/tmp/icu-data-filter.json ./configure --disable-tests --disable-samples \
        --disable-extras --disable-icuio --disable-layoutex --prefix=/tmp/icu-inst >/dev/null \
    && make -j"$(nproc)" >/dev/null && make install >/dev/null \
    && install -Dm755 /tmp/icu-inst/lib/libicudata.so.${v} /opt/icu-data/libicudata.so.${v%%.*} \
    && install -Dm644 /tmp/icu/LICENSE /opt/icu-data/LICENSE \
    && cd / && rm -rf /tmp/icu* /var/lib/apt/lists/*

ARG RUST_TOOLCHAIN=nightly-2026-04-17
ENV RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo PATH=/opt/cargo/bin:$PATH
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain ${RUST_TOOLCHAIN} \
    && chmod -R a+rwX /opt/rustup /opt/cargo
WORKDIR /src

# Minimal FFmpeg 7.1 for Qt Multimedia. The client's CPU fallback paints frames
# through QVideoSink, and Qt Multimedia on Linux only works with its FFmpeg media
# plugin, which links Qt's own FFmpeg 7.1 shared libraries (libavcodec.so.61 ... 19 MB
# unpacked, with every codec). The plugin is only the glue to QVideoSink here (the
# client decodes with its own static FFmpeg), so build the same release (same sonames
# and API) with no codecs, muxers or protocols; make-appimage.sh swaps the libraries
# in for the client. LGPL, shared.
ARG QT_FFMPEG_VERSION=n7.1
RUN git clone -q --depth 1 -b ${QT_FFMPEG_VERSION} https://github.com/FFmpeg/FFmpeg.git /tmp/ffmpeg-qt \
    && cd /tmp/ffmpeg-qt && ./configure --prefix=/opt/qt-ffmpeg-min --libdir=/opt/qt-ffmpeg-min/lib \
       --enable-shared --disable-static --enable-pic --disable-programs --disable-doc --disable-debug \
       --disable-autodetect --disable-everything --disable-avdevice --disable-avfilter --disable-network \
       --enable-swscale --enable-swresample >/dev/null \
    && make -j"$(nproc)" >/dev/null && make install >/dev/null \
    && install -Dm644 COPYING.LGPLv2.1 /opt/qt-ffmpeg-min/share/licenses/ffmpeg-qt/COPYING.LGPLv2.1 \
    && cd / && rm -rf /tmp/ffmpeg-qt
